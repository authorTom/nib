# Nib — Compose environment template.
#
# Copy this file to ".env" (same directory as compose.yaml) and edit as needed.
# Docker Compose reads a sibling ".env" automatically for ${...} interpolation.
# Real ".env" files are gitignored; only this template is tracked.

# Host port to publish the web UI on (container always listens on 8080).
NIB_PORT=8080

# Image to run. Default is the latest multi-arch build from GHCR.
# Pin an immutable tag for reproducible/rollback-friendly deploys, e.g.:
#   NIB_IMAGE=ghcr.io/authortom/nib:sha-fe1d50d
NIB_IMAGE=ghcr.io/authortom/nib:latest


# ---- Server vault ----------------------------------------------------------
# With the server vault on, your notes are stored as .md files in the container
# (the "nib-vault" volume in compose.yaml) instead of on your device — so Nib
# works from any browser, including Safari and mobile, with nothing kept
# locally. The app still offers a local folder / in-browser vault too; you pick
# on first load.
#
# Set to "false" to turn it off and run Nib as the purely static app it was.
NIB_SERVER_VAULT=true

# Name shown in the app for the server vault.
NIB_VAULT_NAME=My Notes

# Password for the server vault.
#
# LEAVING THIS BLANK MEANS NO PASSWORD: anyone who can reach the port can read
# and write every note. That's fine when the port is already protected (a VPN,
# Tailscale, or an authenticating reverse proxy) and a bad idea otherwise.
# There is one shared password — Nib has no user accounts.
NIB_PASSWORD=

# Optional. A fixed secret used to sign session cookies, so sign-ins survive a
# restart. Leave blank and a new one is generated at every boot, which signs
# everyone out. Generate one with:  openssl rand -base64 32
NIB_SESSION_SECRET=

# How long a sign-in lasts, in days (default 30).
# NIB_SESSION_TTL_DAYS=30


# ---- API (for agents and scripts) ------------------------------------------
# Nib exposes a REST API at /api/v1 so an agent can search, read and write your
# knowledge base. It is OFF unless you set a token below, and it needs the
# server vault above — a local folder or in-browser vault lives on your device,
# where nothing outside the browser can reach it.
#
# Comma-separated tokens. Each is either a bare secret (read-write) or
# "name:scope:secret", where scope is "r" (read-only) or "rw". Secrets must be
# at least 16 characters. Generate one with:  openssl rand -base64 32
#
#   NIB_API_TOKENS=hermes:rw:REPLACE_WITH_A_LONG_RANDOM_SECRET
#
# TREAT THESE LIKE PASSWORDS. A read-write token can create, edit and delete
# every note. Give each consumer its own token so you can revoke one without
# disturbing the rest, and prefer "r" for anything that only needs to read.
NIB_API_TOKENS=

# Optional. Origins allowed to call /api/v1 from a browser (comma-separated, or
# "*"). Leave blank unless a web page needs to call the API directly — a script
# or a server-side agent never needs this. Cookies are never accepted on
# /api/v1, so a permitted origin still has to present a token.
# NIB_API_CORS_ORIGINS=


# ---- AI assistant ----------------------------------------------------------
# Nothing to set here. API keys are entered in the app's assistant settings and
# stored in your browser — they are never sent to or held by the Nib server.
