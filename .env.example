# Nib — Compose environment template.
#
# Copy this file to ".env" (same directory as compose.yaml) and edit as needed.
# Docker Compose reads a sibling ".env" automatically for ${...} interpolation.
# Real ".env" files are gitignored; only this template is tracked.
#
# NOTE: Nib has no server-side password or secret to set. It's a static SPA;
# the vault, tasks, bookmarks and AI API keys all live in the browser. The only
# knobs below are the host port and which published image tag to run.

# Host port to publish the web UI on (container always listens on 8080).
NIB_PORT=8080

# Image to run. Default is the latest multi-arch build from GHCR.
# Pin an immutable tag for reproducible/rollback-friendly deploys, e.g.:
#   NIB_IMAGE=ghcr.io/authortom/nib:sha-fe1d50d
NIB_IMAGE=ghcr.io/authortom/nib:latest
